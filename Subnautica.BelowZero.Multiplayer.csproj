<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>Subnautica.Client</AssemblyName>
    <RootNamespace>Subnautica</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Deterministic>true</Deterministic>

    <!-- Game Managed Path Detection -->
    <GameManagedPath Condition="'$(GameManagedPath)' == '' and '$(SUBNAUTICA_DIR)' != ''">$(SUBNAUTICA_DIR)/SubnauticaZero_Data/Managed</GameManagedPath>
    <GameManagedPath Condition="'$(GameManagedPath)' == '' and Exists('/home/rko735/.steam/debian-installation/steamapps/common/SubnauticaZero/SubnauticaZero_Data/Managed')">/home/rko735/.steam/debian-installation/steamapps/common/SubnauticaZero/SubnauticaZero_Data/Managed</GameManagedPath>
    <GameManagedPath Condition="'$(GameManagedPath)' == '' and Exists('$(HOME)/.steam/steam/steamapps/common/SubnauticaZero/SubnauticaZero_Data/Managed')">$(HOME)/.steam/steam/steamapps/common/SubnauticaZero/SubnauticaZero_Data/Managed</GameManagedPath>
    <GameManagedPath Condition="'$(GameManagedPath)' == '' and Exists('D:/SteamLibrary/steamapps/common/SubnauticaZero/SubnauticaZero_Data/Managed')">D:/SteamLibrary/steamapps/common/SubnauticaZero/SubnauticaZero_Data/Managed</GameManagedPath>
    <GameManagedPath Condition="'$(GameManagedPath)' == '' and Exists('C:/Program Files (x86)/Steam/steamapps/common/SubnauticaZero/SubnauticaZero_Data/Managed')">C:/Program Files (x86)/Steam/steamapps/common/SubnauticaZero/SubnauticaZero_Data/Managed</GameManagedPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild" Version="0.4.3" PrivateAssets="All" />
    <PackageReference Include="BepInEx.Core" Version="5.4.21" />
    <PackageReference Include="Lib.Harmony" Version="2.2.2" />
    <PackageReference Include="LiteNetLib" Version="1.1.0" />
    <PackageReference Include="MessagePack" Version="2.5.187" />
    <PackageReference Include="DiscordRichPresence" Version="1.2.1.24" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Net.Http" />
    <Reference Include="Assembly-CSharp">
      <HintPath>$(GameManagedPath)/Assembly-CSharp.dll</HintPath>
      <Publicize>true</Publicize>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp-firstpass">
      <HintPath>$(GameManagedPath)/Assembly-CSharp-firstpass.dll</HintPath>
      <Publicize>true</Publicize>
      <Private>false</Private>
    </Reference>
    <Reference Include="Sentry">
      <HintPath>$(GameManagedPath)/Sentry.dll</HintPath>
      <Publicize>true</Publicize>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(GameManagedPath)/UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GameManagedPath)/UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AudioModule">
      <HintPath>$(GameManagedPath)/UnityEngine.AudioModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AnimationModule">
      <HintPath>$(GameManagedPath)/UnityEngine.AnimationModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>$(GameManagedPath)/UnityEngine.PhysicsModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.Physics2DModule">
      <HintPath>$(GameManagedPath)/UnityEngine.Physics2DModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.ImageConversionModule">
      <HintPath>$(GameManagedPath)/UnityEngine.ImageConversionModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(GameManagedPath)/UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(GameManagedPath)/UnityEngine.UIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(GameManagedPath)/UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UnityWebRequestModule">
      <HintPath>$(GameManagedPath)/UnityEngine.UnityWebRequestModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UnityWebRequestWWWModule">
      <HintPath>$(GameManagedPath)/UnityEngine.UnityWebRequestWWWModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.DirectorModule">
      <HintPath>$(GameManagedPath)/UnityEngine.DirectorModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.ParticleSystemModule">
      <HintPath>$(GameManagedPath)/UnityEngine.ParticleSystemModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(GameManagedPath)/UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.Addressables">
      <HintPath>$(GameManagedPath)/Unity.Addressables.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.ResourceManager">
      <HintPath>$(GameManagedPath)/Unity.ResourceManager.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>$(GameManagedPath)/Unity.TextMeshPro.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.Timeline">
      <HintPath>$(GameManagedPath)/Unity.Timeline.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(GameManagedPath)/Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="FMODUnity">
      <HintPath>$(GameManagedPath)/FMODUnity.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="com.rlabrecque.steamworks.net">
      <HintPath>$(GameManagedPath)/com.rlabrecque.steamworks.net.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="PlatformIODefault">
      <HintPath>$(GameManagedPath)/PlatformIODefault.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="PlatformUtilsDefault">
      <HintPath>$(GameManagedPath)/PlatformUtilsDefault.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Exclude standalone executable helper projects -->
  <ItemGroup>
    <Compile Remove="Subnautica.Firewall/**" />
    <Compile Remove="Subnautica.NetBird/**" />
    <Compile Remove="Subnautica.NetworkDebugger/**" />
    <Compile Remove="scratch/**" />
  </ItemGroup>
</Project>
